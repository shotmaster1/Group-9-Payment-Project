
const OAUTH_URL =
  'https://capstoneproject.proxy.beeceptor.com/oauth/token';

const AUTHORIZE_URL =
  'https://capstoneproject.proxy.beeceptor.com/authorize';

const REQUEST_TIMEOUT_MS = 10000;
const TOKEN_REFRESH_SKEW_MS = 30000;

// Store the OAuth token in server memory only.
let cachedToken = null;
let tokenRequestPromise = null;


/**
 * Fetch with a timeout.
 */
async function fetchWithTimeout(url, options = {}) {
  const controller = new AbortController();

  const timeout = setTimeout(() => {
    controller.abort();
  }, REQUEST_TIMEOUT_MS);

  try {
    return await fetch(url, {
      ...options,
      signal: controller.signal
    });
  } catch (error) {
    if (controller.signal.aborted) {
      const timeoutError = new Error(
        'Payment service request timed out'
      );

      timeoutError.name = 'TimeoutError';
      throw timeoutError;
    }

    throw error;
  } finally {
    clearTimeout(timeout);
  }
}


/**
 * Safely parse a response body.
 */
async function readResponseBody(response) {
  const text = await response.text();

  if (!text) {
    return {};
  }

  try {
    return JSON.parse(text);
  } catch {
    return {};
  }
}


/**
 * Determine OAuth token expiry.
 *
 * Supported examples:
 *   expires_in: 3600
 *   expires_at: "2026-12-31T12:00:00Z"
 *
 * Confirm the actual OAuth response format before relying
 * on these fields in production.
 */
function getOAuthExpiry(data) {
  if (
    typeof data.expires_in === 'number' &&
    Number.isFinite(data.expires_in) &&
    data.expires_in > 0
  ) {
    return Date.now() + data.expires_in * 1000;
  }

  const absoluteExpiry =
    data.expires_at ?? data.expiresAt;

  if (typeof absoluteExpiry === 'string') {
    const parsed = Date.parse(absoluteExpiry);

    if (Number.isFinite(parsed)) {
      return parsed;
    }
  }

  return null;
}


/**
 * Check whether the cached OAuth token is still valid.
 */
function isCachedTokenValid() {
  return Boolean(
    cachedToken &&
    cachedToken.expiresAt !== null &&
    Date.now() + TOKEN_REFRESH_SKEW_MS <
      cachedToken.expiresAt
  );
}


/**
 * Get an OAuth access token.
 *
 * Reuse a cached token only when its expiry is known
 * and it has not expired.
 */
async function getAccessToken() {
  if (isCachedTokenValid()) {
    return cachedToken.value;
  }

  // Avoid duplicate concurrent OAuth requests.
  if (tokenRequestPromise) {
    return tokenRequestPromise;
  }

  const request = (async () => {
    const response = await fetchWithTimeout(OAUTH_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        merchantId: process.env.MA_MERCHANT_ID,
        secretKey: process.env.MA_SECRET_KEY
      })
    });

    const data = await readResponseBody(response);

    if (!response.ok) {
      const error = new Error(
        'OAuth token request failed'
      );

      error.statusCode = response.status;
      throw error;
    }

    if (
      typeof data.access_token !== 'string' ||
      !data.access_token
    ) {
      throw new Error(
        'OAuth response did not contain access_token'
      );
    }

    const expiresAt = getOAuthExpiry(data);

    // Do not cache a token if its expiry is unknown.
    cachedToken = expiresAt
      ? {
          value: data.access_token,
          expiresAt
        }
      : null;

    return data.access_token;
  })();

  tokenRequestPromise = request;

  try {
    return await request;
  } finally {
    if (tokenRequestPromise === request) {
      tokenRequestPromise = null;
    }
  }
}


/**
 * Obtain a fresh OAuth token after a 401 response.
 */
async function refreshAccessToken(rejectedToken) {
  // Another concurrent request may already have refreshed it.
  if (
    cachedToken &&
    cachedToken.value !== rejectedToken &&
    isCachedTokenValid()
  ) {
    return cachedToken.value;
  }

  if (
    cachedToken &&
    cachedToken.value === rejectedToken
  ) {
    cachedToken = null;
  }

  return getAccessToken();
}


/**
 * Send the payment authorization request.
 */
async function sendAuthorizationRequest(token, payment) {
  if (typeof token !== 'string' || !token) {
    throw new Error(
      'Missing OAuth access token'
    );
  }

  return fetchWithTimeout(AUTHORIZE_URL, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    },
    body: JSON.stringify({
      OrderId: payment.orderId,
      CardDetails: {
        CardNumber: payment.cardNumber,
        CardMonth: payment.cardMonth,
        CardYear: payment.cardYear,
        CCV: payment.ccv
      },
      RequestedAmount: payment.amount
    })
  });
}


/**
 * Authorize a payment.
 *
 * If the payment proxy returns 401, refresh the OAuth
 * token and retry the request only once.
 */
async function authorizePayment(payment) {
  let token = await getAccessToken();

  let response = await sendAuthorizationRequest(
    token,
    payment
  );

  if (response.status === 401) {
    token = await refreshAccessToken(token);

    response = await sendAuthorizationRequest(
      token,
      payment
    );
  }

  return response;
}


/**
 * Standard structured error response.
 */
function paymentError({
  statusCode = 502,
  code = 'PAYMENT_ERROR',
  status = 'Payment Error',
  message = 'The payment could not be processed.',
  orderId = null
} = {}) {
  return {
    success: false,
    statusCode,
    code,
    orderId,
    status,
    message,
    authorizationToken: null,
    tokenExpirationDate: null,
    authorizedAmount: 0
  };
}


/**
 * Process a payment and map the API response.
 */
async function processPayment(payment) {
  try {
    const response = await authorizePayment(payment);
    const data = await readResponseBody(response);

    const orderId =
      data.OrderId ?? payment.orderId;

    // Successful payment authorization.
    if (
      response.status === 200 &&
      data.Success === true
    ) {
      return {
        success: true,
        statusCode: 200,
        code: 'PAYMENT_AUTHORIZED',
        orderId,
        authorizationToken:
          data.AuthorizationToken ?? null,
        tokenExpirationDate:
          data.TokenExpirationDate ?? null,
        authorizedAmount:
          data.AuthorizedAmount ?? null,
        reason: data.Reason || ''
      };
    }

    // Incorrect card details or invalid request.
    if (response.status === 400) {
      return paymentError({
        statusCode: 400,
        code: 'INVALID_PAYMENT_REQUEST',
        status: 'Payment Declined',
        message:
          data.Reason ||
          'The payment information is invalid.',
        orderId
      });
    }

    // Token refresh failed or authorization remains invalid.
    if (response.status === 401) {
      return paymentError({
        statusCode: 401,
        code: 'PAYMENT_AUTHORIZATION_FAILED',
        status: 'Authorization Failed',
        message:
          'Payment authorization could not be completed.',
        orderId
      });
    }

    // Insufficient funds.
    if (response.status === 402) {
      return paymentError({
        statusCode: 402,
        code: 'INSUFFICIENT_FUNDS',
        status: 'Payment Declined - Insufficient Funds',
        message:
          data.Reason ||
          'There are insufficient funds to complete the purchase.',
        orderId
      });
    }

    // Payment validation failure.
    if (response.status === 422) {
      return paymentError({
        statusCode: 422,
        code: 'PAYMENT_VALIDATION_FAILED',
        status: 'Payment Validation Failed',
        message:
          data.Reason ||
          'The payment request could not be processed.',
        orderId
      });
    }

    // Payment service errors, including 500, 502, and 503.
    if (response.status >= 500) {
      console.error(
        'Payment service server error:',
        response.status,
        typeof data.Error === 'string'
          ? data.Error
          : 'No error details provided'
      );

      return paymentError({
        statusCode: response.status,
        code: 'PAYMENT_SERVICE_ERROR',
        status: 'Payment Service Unavailable',
        message:
          'The payment service encountered an error. Please try again later.',
        orderId
      });
    }

    // Unexpected status or malformed success response.
    return paymentError({
      statusCode: response.status,
      code: 'UNEXPECTED_PAYMENT_RESPONSE',
      status: 'Payment Error',
      message:
        'The payment service returned an unexpected response.',
      orderId
    });
  } catch (error) {
    // Never log tokens, card numbers, CCV, or request bodies.
    console.error(
      'Payment integration failure:',
      error.name || 'Error',
      error.statusCode ?? ''
    );

    if (error.name === 'TimeoutError') {
      return paymentError({
        statusCode: 504,
        code: 'PAYMENT_TIMEOUT',
        status: 'Payment Timeout',
        message:
          'The payment service did not respond in time.',
        orderId: payment.orderId
      });
    }

    if (error.statusCode) {
      return paymentError({
        statusCode: error.statusCode,
        code: 'OAUTH_TOKEN_REQUEST_FAILED',
        status: 'Authentication Service Error',
        message:
          'Unable to obtain authorization from the payment service.',
        orderId: payment.orderId
      });
    }

    return paymentError({
      statusCode: 503,
      code: 'PAYMENT_SERVICE_UNAVAILABLE',
      status: 'Payment Service Unavailable',
      message:
        'Unable to contact the payment service.',
      orderId: payment.orderId
    });
  }
}


module.exports = {
  getAccessToken,
  authorizePayment,
  processPayment
};
